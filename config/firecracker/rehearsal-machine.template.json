{
  "boot-source": {
    "kernel_image_path": "__KERNEL_IMAGE_PATH__",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off init=/sbin/king-file-write-v1"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "__READ_ONLY_ROOTFS_PATH__",
      "is_root_device": true,
      "is_read_only": true
    },
    {
      "drive_id": "workspace",
      "path_on_host": "__SYNTHETIC_WORKSPACE_IMAGE_PATH__",
      "is_root_device": false,
      "is_read_only": false
    }
  ],
  "machine-config": {
    "vcpu_count": 1,
    "mem_size_mib": 128,
    "smt": false,
    "track_dirty_pages": false
  },
  "network-interfaces": []
}
