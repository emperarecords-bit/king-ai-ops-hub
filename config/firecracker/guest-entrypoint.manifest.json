{
  "entrypoint": "/sbin/king-file-write-v1",
  "entrypointSha256": "__PINNED_ENTRYPOINT_SHA256__",
  "kernelSha256": "__PINNED_KERNEL_SHA256__",
  "rootfsSha256": "__PINNED_ROOTFS_SHA256__",
  "workspaceGuestPath": "/workspace",
  "network": "none",
  "environmentAllowlist": [],
  "limits": {
