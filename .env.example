# ---------------------------------------------------------------------------
# King AI Operations Hub — environment
#
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# Anything named NEXT_PUBLIC_* is compiled into the browser bundle. Nothing
# secret may ever use that prefix; a unit test enforces this.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database --------------------------------------------------------------
# Local Docker (see docker-compose.yml). For Supabase, use the *session pooler*
# connection string and the `app_server` role, not `postgres`.
#   postgresql://app_server:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://king:king@localhost:5433/king_ai_hub

# Migration-time connection. Needs DDL rights; the running app must not use it.
DATABASE_MIGRATION_URL=postgresql://king:king@localhost:5433/king_ai_hub

# --- Supabase Auth ---------------------------------------------------------
# Publishable values — safe in the browser, these two only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Not used in the request path; present for future admin scripts.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Secret encryption -----------------------------------------------------
# 32 random bytes, base64. Generate with:  openssl rand -base64 32
APP_ENCRYPTION_KEY=replace-me-with-32-random-bytes-base64
APP_ENCRYPTION_KEY_VERSION=1
# Set during rotation; see SECURITY.md §6.
# APP_ENCRYPTION_KEY_V2=

# --- Model providers -------------------------------------------------------
# Server-only. Read exclusively by src/lib/env.server.ts.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- Limits ----------------------------------------------------------------
# Whole-run wall clock, milliseconds.
RUN_TIMEOUT_MS=180000
# Single provider call, milliseconds.
PROVIDER_TIMEOUT_MS=90000
# Retries per provider call (only for rate_limited / overloaded / timeout).
PROVIDER_MAX_RETRIES=2
# Run submissions allowed per user per minute.
RATE_LIMIT_RUNS_PER_MINUTE=10
# Default per-project monthly ceiling, USD micros. 25_000_000 = $25.00
DEFAULT_MONTHLY_SPEND_LIMIT_MICROS=25000000

# --- Logging ---------------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL=info
