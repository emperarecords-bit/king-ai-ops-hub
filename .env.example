# ---------------------------------------------------------------------------
# King AI Operations Hub — environment
#
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# Anything named NEXT_PUBLIC_* is compiled into the browser bundle. Nothing
# secret may ever use that prefix; a unit test enforces this.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database --------------------------------------------------------------
# THREE roles (O-22, DEPLOYMENT.md §10). rls.sql creates app_server + app_system
# (NOLOGIN BYPASSRLS, owns the app.* dispatch functions) on every migrate.
#
# DATABASE_URL — the RUNNING APP (web + worker + jobs). In PRODUCTION this MUST be
# the non-superuser `app_server` role so RLS is the enforced net; the app refuses
# to boot with a superuser URL or the dev app_server password.
#   postgresql://app_server:<real-pw>@<managed-pg-host>:5432/king_ai_hub
# Local Docker dev uses the superuser `king` for convenience (RLS bypassed; the
# app-layer org/project filters still isolate). Prove RLS locally: `npm run test:rls`.
DATABASE_URL=postgresql://king:king@localhost:5433/king_ai_hub

# DATABASE_MIGRATION_URL — the MIGRATION role (owner/DDL). Used by db:migrate and
# by test fixtures (getSetupDb). The running app must NEVER use it.
DATABASE_MIGRATION_URL=postgresql://king:king@localhost:5433/king_ai_hub

# --- Supabase Auth ---------------------------------------------------------
# Publishable values — safe in the browser, these two only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Not used in the request path; present for future admin scripts.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Secret encryption -----------------------------------------------------
# 32 random bytes, base64. Generate with:  openssl rand -base64 32
APP_ENCRYPTION_KEY=replace-me-with-32-random-bytes-base64
APP_ENCRYPTION_KEY_VERSION=1
# Set during rotation; see SECURITY.md §6.
# APP_ENCRYPTION_KEY_V2=

# --- Model providers -------------------------------------------------------
# Server-only. Read exclusively by src/lib/env.server.ts.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Optional vendors — leave unset to disable. Gemini keys from aistudio.google.com
# (an unbilled account runs the free tier); DeepSeek keys from platform.deepseek.com.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# --- Limits ----------------------------------------------------------------
# Whole-run wall clock, milliseconds.
RUN_TIMEOUT_MS=180000
# Single provider call, milliseconds.
PROVIDER_TIMEOUT_MS=90000
# Retries per provider call (only for rate_limited / overloaded / timeout).
PROVIDER_MAX_RETRIES=2
# Run submissions allowed per user per minute.
RATE_LIMIT_RUNS_PER_MINUTE=10
# Default per-project monthly ceiling, USD micros. 25_000_000 = $25.00
DEFAULT_MONTHLY_SPEND_LIMIT_MICROS=25000000

# --- Logging ---------------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL=info

# --- Background worker (O-21) ----------------------------------------------
# The durable run worker (`npm run worker`) shares DATABASE_URL and the provider
# keys above. In the cloud it is a separate long-lived process (see fly.toml).
# It also runs the O-23 document-indexing jobs. No extra variables are required.

# --- Object storage / Cloud Project Library (O-23) -------------------------
# Source FILES live in S3-compatible object storage, NOT in Postgres. Uploads
# and downloads are always server-mediated — these credentials are server-only
# and must NEVER reach the browser. See DEPLOYMENT.md §11.
#
# STORAGE_DRIVER: `local` (filesystem, dev/test — the default) or `s3`.
STORAGE_DRIVER=local
# Local driver: where files are written in dev (a scratch dir by default).
# LOCAL_OBJECT_STORE_DIR=

# S3 driver (Fly Tigris / Cloudflare R2 / MinIO / AWS). Required when
# STORAGE_DRIVER=s3 — production refuses to start if any is missing/placeholder.
# S3_ENDPOINT=https://fly.storage.tigris.dev
# S3_REGION=auto
# S3_BUCKET=king-ai-hub-library
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Upload ceilings (explicit + configurable).
# MAX_UPLOAD_BYTES=2000000
# MAX_UPLOAD_BATCH=20

# --- Action executors: enablement allowlist (Phase 2/3) --------------------
# EXECUTORS_ENABLED is a comma-separated allowlist of executor ENABLEMENT IDS.
# UNSET MEANS EVERY EXECUTOR IS DISABLED — absence of configuration can never
# enable execution (src/domain/execution/dispatch.ts). Each id is matched by
# exact string equality, so a prefix, a different case, or a name that is not
# an enablement id enables nothing.
#
# Valid ids: git_pr, org_delegation, accuratebids_quote, supabase_deploy,
#            vercel_mutation, file_write
# NOTE: file_write is named by its ACTION TYPE. The shared no-op's executor id
#       (`noop_dry_run`) is NOT an enablement id and enables nothing.
# EXECUTORS_ENABLED=git_pr,accuratebids_quote,org_delegation
#
# EXECUTORS_KILL_SWITCH=1 (or `true`) empties the allowlist instantly — no
# deploy, no code change. Any other value leaves the allowlist alone.
# EXECUTORS_KILL_SWITCH=

# --- Connector credentials (owner-gated; every one optional) ---------------
# Each connector FAILS CLOSED without its credential: the client returns a
# typed refusal and performs no I/O at all. Absence is a safe posture, not a
# bug. A PLACEHOLDER is worse than absence — it is truthy, so the connector
# reports itself configured and then fails at the first API call instead of at
# boot. Production refuses to start when any of these is set to a placeholder
# or to whitespace (src/lib/env.server.ts). None of them is ever written to the
# database; the *_links rows hold identifiers only, never a secret.
#
# GitHub App (src/domain/github/client.ts) — governed PR / merge / rerun.
# GITHUB_APP_ID=
# PEM including newlines; quote it or use \n escapes per your secret store.
# GITHUB_APP_PRIVATE_KEY=
#
# Supabase Management API (src/domain/supabase/client.ts) — the read surface
# plus the single-edge-function deploy. There is no live SQL path by design.
# SUPABASE_MANAGEMENT_TOKEN=
#
# Vercel API (src/domain/vercel/client.ts) — the read surface plus
# redeploy / promote / rollback. A token ALONE is not enough: vercel_mutation
# also needs `vercel_mutation` in EXECUTORS_ENABLED and a vercel_project_links
# row for the workspace (npm run admin:link-vercel-project).
# VERCEL_TOKEN=
